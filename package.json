{
  "name": "afterlight-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4324",
    "build": "next build",
